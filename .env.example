# Z.AI GLM API (https://z.ai/model-api)
ZAI_API_KEY=your_zai_api_key_here

# Model pilihan: glm-4.5-air (recommended), glm-4.5, glm-4.5-flash (free), glm-4.7
ZAI_MODEL=glm-4.5-air

# btc-trading-bot VPS endpoint
BOT_API_URL=http://your-vps-tokyo-ip:3000
BOT_API_SECRET=your_shared_secret_here

# Exchanges (untuk data agents)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Polymarket
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# Swarm config
SWARM_WINDOW=15m           # 5m atau 15m
SWARM_CONFIDENCE_THRESHOLD=0.70
SWARM_MAX_AGENTS=8
LOG_LEVEL=info